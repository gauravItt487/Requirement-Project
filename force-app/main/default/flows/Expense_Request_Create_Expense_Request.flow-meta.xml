            <name>Amount_greater_or_equal_to_1_lac</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Expense_Amount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
